{
	"name": "pc-part-scraper",
	"version": "0.2.0",
	"private": true,
	"scripts": {
		"scrape": "ts-node src/scraper/cli.ts",
		"scrape:dev": "ts-node -T src/scraper/cli.ts",
		"probe": "ts-node -T src/scraper/probe.ts",
		"count": "ts-node src/counter.ts",
		"output": "ts-node src/output.ts",
		"typecheck": "tsc --noEmit",
		"test": "node -r ts-node/register --test test/*.test.ts",
		"zip": "cd data; for dir in json jsonl csv; do zip -r \"${dir}.zip\" \"$dir\" -x \"*.DS_Store\"; done"
	},
	"devDependencies": {
		"@types/node": "^22.10.2",
		"ts-node": "^10.9.2",
		"typescript": "^5.7.2"
	},
	"dependencies": {
		"puppeteer": "^25.8.0",
		"zod": "^4.4.3"
	},
	"optionalDependencies": {
		"puppeteer-extra": "^3.3.6",
		"puppeteer-extra-plugin-stealth": "^2.11.2"
	}
}
